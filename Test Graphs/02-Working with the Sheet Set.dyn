        "TextblockHeight": 0.0,
        "IsOptionalInPortsCollapsed": false,
        "IsUnconnectedOutPortsCollapsed": false,
        "HasToggledOptionalInPorts": false,
        "HasToggledUnconnectedOutPorts": false,
        "Background": "#FFC1D676"
      },
      {
        "Id": "3457c04dd07f4321bdce043af9f404bf",
        "Title": "You can also set any of the built-in property values.\r\nConnect the Database.ByFilename output port to the SheetSet.ByDatabase input port to apply these changes.\r\n\r\nIf the return values are null, the changes were not able to be made. The sheet set file being opened in this example is a sample file included with AutoCAD and may not be accessible.",
        "DescriptionText": null,
        "IsExpanded": true,
        "WidthAdjustment": 0.0,
        "HeightAdjustment": 0.0,
        "UserSetWidth": 0.0,
        "UserSetHeight": 0.0,
        "Nodes": [],
        "HasNestedGroups": false,
        "Left": 1018.2087334691928,
        "Top": 1067.711376194324,
        "Width": 0.0,
        "Height": 0.0,
        "FontSize": 36.0,
        "GroupStyleId": "00000000-0000-0000-0000-000000000000",
